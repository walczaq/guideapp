# Files in the project root that must NOT be served as public static assets.
# Workers Static Assets reads THIS file (not .wranglerignore) to decide what
# to upload. The Worker entry, its config, and dev/build files don't belong
# on the public origin.
worker.js
wrangler.toml
app
codemagic.yaml
.wranglerignore
.assetsignore
.gitignore
.claude
node_modules
.github
.git
tools
*.md

# Superseded prototypes (v0.1–v0.4). Kept in the repo for history, but not
# served: /_redirects sends their old URLs to the current app.
v0.1.html
v0.2.html
v0.3.html
v0.4.html

# Test suite (dev-only; see tests/README.md).
tests
